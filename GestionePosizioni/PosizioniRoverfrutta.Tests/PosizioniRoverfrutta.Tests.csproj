<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Properties\AssemblyInfo.cs" />
    <None Update="App.config" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="CopyAppConfigForTestHost" AfterTargets="Build">
    <Copy SourceFiles="$(OutputPath)$(TargetFileName).config" DestinationFiles="$(OutputPath)testhost.dll.config" SkipUnchangedFiles="true" Condition="Exists('$(OutputPath)$(TargetFileName).config')" />
  </Target>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="Moq" Version="4.20.72" />
    <PackageReference Include="NUnit" Version="4.3.2" />
    <PackageReference Include="NUnit3TestAdapter" Version="5.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CustomControls\CustomWPFControls.csproj" />
    <ProjectReference Include="..\Models\Models.csproj" />
    <ProjectReference Include="..\PosizioniRoverfrutta\PosizioniRoverfrutta.csproj" />
    <ProjectReference Include="..\QueryManager\QueryManager.csproj" />
  </ItemGroup>

</Project>
