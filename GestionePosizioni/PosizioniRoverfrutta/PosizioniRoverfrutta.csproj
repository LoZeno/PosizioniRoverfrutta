<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>PosizioniRoverfrutta</RootNamespace>
    <AssemblyName>PosizioniRoverfrutta</AssemblyName>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <ApplicationIcon>Content\Pictures\ring-binders.ico</ApplicationIcon>
    <StartupObject>PosizioniRoverfrutta.EntryPoint</StartupObject>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Properties\AssemblyInfo.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Prism.Wpf" Version="9.0.537" />
    <PackageReference Include="RavenDB.Client" Version="7.2.7" />
    <PackageReference Include="System.Configuration.ConfigurationManager" Version="10.0.0" />
    <PackageReference Include="System.Drawing.Common" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CustomControls\CustomWPFControls.csproj" />
    <ProjectReference Include="..\MailWrapper\MailWrapper.csproj" />
    <ProjectReference Include="..\Models\Models.csproj" />
    <ProjectReference Include="..\QueryManager\QueryManager.csproj" />
    <ProjectReference Include="..\ReportManager\ReportManager.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Content\Pictures\**\*" />
    <Content Include="Templates\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
